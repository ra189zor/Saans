# node
node_modules
dist
dist-ssr
*.local
.vite

# python
__pycache__/
*.py[cod]
.venv/
venv/

# editors / os
.DS_Store
.claude
.vscode/

# secrets
.env
kaggle.json

# Source artwork for the question guides — 32 MB of PNGs across both
# languages. The app ships the WebP builds in src/assets/guides/ (1.4 MB),
# which are committed. Rebuild them with: python scripts/build_guides.py
src/assets/*.png
src/assets/urdu assstes/

# trained model weights - too large for git, see the Weights section in README.md
backend/models/*.h5
backend/models/*.pt
server/weights/

# training run outputs (canonical copies live in backend/models/)
notebooks/*.h5
notebooks/*.png

# downloaded datasets (~15 GB, see notebooks/train_xray_model_local.ipynb)
saans_data/
notebooks/*.json
backend/models/*.joblib

# MiniLM sentence encoder for the WHO assistant (~90 MB). Downloads itself on
# first use; the index it produces (who_index.npz) is small and is committed.
backend/models/embedding/

# Cross-encoder that reranks the search hits (~87 MB). Also downloads itself on
# first use, and the assistant falls back to plain vector order without it.
backend/models/reranker/

# Consented captures - children's cough recordings and chest films. Never
# commit these: they are patient data, and no amount of "it is only a demo"
# makes a public repository the right place for them.
backend/data/
