# Copy this file to .env (same folder) and fill in your key.
# .env is gitignored - it must never be committed.

# Ask WHO Assistant. Free tier, no credit card: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional. Change if the default model is retired - the app passes Groq's own
# error message through, which names the problem. Current options include
# llama-3.3-70b-versatile, llama-3.1-8b-instant, openai/gpt-oss-20b.
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional. Force the X-ray demo stand-in even when the weights are present.
# SAANS_DEMO_MODE=1
