# Copy this file to .env (same folder) and fill in your key.
# .env is gitignored - it must never be committed.

# Ask WHO Assistant. Free tier, no credit card: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional. Groq retires models regularly - the llama-3.x ids this project
# first shipped with are already gone. If answers start failing, list what your
# key can actually use and set one of them here:
#
#   curl -H "Authorization: Bearer $GROQ_API_KEY" \
#        -H "User-Agent: saans/0.1" \
#        https://api.groq.com/openai/v1/models
#
# The app passes Groq's own error message through, so a retired id names itself.
#
# The default is openai/gpt-oss-20b: 1,000 requests a day, answers in about a
# second. groq/compound-mini is the alternative, but it routes internally to
# gpt-oss-120b and spends that model's token budget, allows only 250 requests a
# day, and returns HTTP 413 when it reaches for a web tool.
# GROQ_MODEL=openai/gpt-oss-20b

# Optional. Force the X-ray demo stand-in even when the weights are present.
# SAANS_DEMO_MODE=1

# Keep the cough recordings and chest films that carers consent to, so a
# paediatric dataset can be built - there is almost none in public. Off unless
# set to 1, and even then a capture is only kept when the health worker
# confirms the carer agreed to that one. Files land in backend/data/.
# SAANS_COLLECT=1

# Optional. 0 turns off cross-encoder reranking of the handbook search and
# falls back to plain vector order - faster, and worse at dosing questions.
# SAANS_RERANK=1

# Optional. Host port for docker compose; 8042 if unset.
# SAANS_PORT=8042
